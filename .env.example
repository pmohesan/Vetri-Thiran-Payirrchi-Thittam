# Copy this file to ".env" and fill in your keys. Never commit .env.

# Required. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required for hosted images. Create a fine-grained token with Inference Providers permission:
# https://huggingface.co/settings/tokens/new?ownUserPermissions=inference.serverless.write&tokenType=fineGrained
HF_API_KEY=

# ---- Optional tuning -------------------------------------------------------
GEMINI_FLASH_MODEL=gemini-3.5-flash-lite
GEMINI_PRO_MODEL=gemini-3.5-flash-lite

# Hosted image provider (does not download model weights to this computer)
IMAGE_GENERATION_PROVIDER=hf-inference
HF_IMAGE_MODEL=stabilityai/stable-diffusion-3-medium-diffusers

# Optional local Stable Diffusion settings; set IMAGE_GENERATION_PROVIDER=local to use them
SD_MODEL_ID=stable-diffusion-v1-5/stable-diffusion-v1-5
SD_STEPS=25
IMAGE_SIZE=512

# true = skip image generation and draw labelled placeholder images
USE_PLACEHOLDER_IMAGES=false
